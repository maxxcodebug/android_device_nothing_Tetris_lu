    {
      "Name": "GpuUiMinFreq",
      "Path": "/proc/gpufreqv2/limit_table",
      "Values": [
        "boost 1047000",
        "boost 700000",
        "boost 620000",
        "boost 0"
      ],
      "DefaultIndex": 3,
      "ResetOnInit": true,
      "Comments": [
        "Tiers: 1047000 = blur/expensive rendering only, 700000 = launch/perf modes, 620000 = normal touch interaction (skips the slow 400->700 ramp), 0 = release.",
        "Kernel picks lowest supported OPP at or above the requested kHz. Strongest value first."
      ]
